[Unit]
Description=ReconEngine Dashboard Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/recon-engine
ExecStart=/opt/recon-engine/venv/bin/uvicorn dashboard.app:app --host 127.0.0.1 --port 8080 --log-level warning
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
